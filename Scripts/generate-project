#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

force_generation=0
if [[ "${1:-}" == "--force" && $# == 1 ]]; then
    force_generation=1
elif [[ $# -gt 0 ]]; then
    printf 'Usage: %s [--force]\n' "${BASH_SOURCE[0]}" >&2
    exit 2
fi

if [[ -d Oesap.xcodeproj && "$force_generation" == 0 ]]; then
    printf 'Oesap.xcodeproj already exists; skipping generation. Run `just regenerate` to replace it.\n'
    exit 0
fi

required_version="2.46.0"
if ! command -v xcodegen >/dev/null 2>&1; then
    printf 'XcodeGen %s is required. Install it before generating the project.\n' "$required_version" >&2
    exit 1
fi

actual_version="$(xcodegen --version | awk '{print $2}')"
if [[ "$actual_version" != "$required_version" ]]; then
    printf 'Expected XcodeGen %s, found %s\n' "$required_version" "$actual_version" >&2
    exit 1
fi

# Xcode stores its Swift package lock inside the generated (git-ignored)
# project. Keep the canonical copy at the repository root and restore it after
# project generation. On the first run after resolving packages, adopt Xcode's
# generated lock as the canonical copy.
generated_lock="Oesap.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved"
if [[ ! -f Package.resolved && -f "$generated_lock" ]]; then
    cp "$generated_lock" Package.resolved
fi
xcodegen generate --spec project.yml
if [[ -f Package.resolved ]]; then
    mkdir -p "$(dirname "$generated_lock")"
    cp Package.resolved "$generated_lock"
fi
